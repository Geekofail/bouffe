APP_NAME=Bouffe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://bouffe.local
APP_TIMEZONE=Europe/Luxembourg

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données (WampServer) -------------------------------------------
# MariaDB : DB_CONNECTION=mariadb, port 3307 si MySQL ET MariaDB sont installés
#           dans Wamp (MySQL garde le 3306), sinon 3306.
# MySQL   : DB_CONNECTION=mysql, port 3306.
# Utilisateur par défaut de Wamp : root sans mot de passe.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=bouffe
DB_USERNAME=root
DB_PASSWORD=
# Moteur de stockage forcé (Wamp crée parfois les tables en MyISAM par défaut)
DB_ENGINE=InnoDB

# Sessions stockées en base ; "Rester connecté" utilise un cookie de longue durée.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# À passer à true en production (HTTPS chez OVH)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Pas de worker de file d'attente sous Wamp : exécution synchrone
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Envoi des e-mails (récapitulatif du dimanche, lot 20). « log » = rien n'est envoyé,
# le message est écrit dans storage/logs. Exemple avec le SMTP de Free :
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.free.fr  MAIL_PORT=465  MAIL_SCHEME=smtps
#   MAIL_USERNAME=identifiant  MAIL_PASSWORD=mot-de-passe
MAIL_MAILER=log
MAIL_FROM_ADDRESS="bouffe@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Bouffe -------------------------------------------------------------------
# Mot de passe initial des comptes Pierre et Monique créés par `php artisan db:seed`.
# Laisser vide pour générer un mot de passe aléatoire (affiché dans le terminal).
BOUFFE_SEED_PASSWORD=
# Nombre de personnes à chaque repas (portions proposées, calcul des restes).
BOUFFE_HOUSEHOLD_SIZE=2
# Part de portion comptée pour un enfant invité (0.5 = demi-portion)
BOUFFE_CHILD_PORTION=0.5

VITE_APP_NAME="${APP_NAME}"

# Sauvegardes (Paramètres → Sauvegardes, php artisan bouffe:backup / bouffe:restore)
# Dossier : vide = storage/app/backups. Un dossier OneDrive garde une copie hors du PC.
BOUFFE_BACKUP_PATH=
# Sauvegarde automatique si la dernière date de plus de N jours (0 = désactivée)
BOUFFE_BACKUP_AUTO_DAYS=7
# Nombre de sauvegardes automatiques conservées
BOUFFE_BACKUP_KEEP=10
# Sauvegarde avant chaque fusion d'ingrédients (lot 11)
BOUFFE_BACKUP_BEFORE_MERGE=true

# Stock : badges « bientôt » (jours avant la date limite)
BOUFFE_STOCK_DLC_SOON_DAYS=3
BOUFFE_STOCK_DDM_SOON_DAYS=7
BOUFFE_STOCK_DEDUCTION=ask

# Tickets de caisse (lot 23) — aussi réglables dans Paramètres → Tickets de caisse
# Service : mistral · azure · none
BOUFFE_RECEIPTS_PROVIDER=mistral
MISTRAL_API_KEY=
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
# Lectures par mois au-delà desquelles on repasse en saisie manuelle
BOUFFE_RECEIPTS_MONTHLY_CAP=50
# Conservation des photos de tickets (mois)
BOUFFE_RECEIPTS_KEEP_MONTHS=12

# Assistant culinaire (lot 33) — aussi réglable dans Paramètres → Assistant.
# Même clé Mistral que les tickets (MISTRAL_API_KEY ci-dessus). Plafond mensuel en euros.
BOUFFE_ASSISTANT_ENABLED=true
BOUFFE_ASSISTANT_MONTHLY_CAP=1
# MISTRAL_CHAT_MODEL=mistral-small-latest

# Mise en ligne et sécurité (lot 25) — voir docs/10-mise-en-ligne-ovh.md
# Double authentification obligatoire pour l'administrateur et les responsables (défaut : oui si APP_ENV=production)
# BOUFFE_2FA_REQUIRED=true
# E-mail « nouvelle connexion depuis… » (navigateur jamais vu sur le compte)
BOUFFE_NEW_DEVICE_EMAIL=true
# Journal des connexions : durée de conservation (jours)
BOUFFE_LOGIN_JOURNAL_DAYS=180
# Politique de contenu : enforce · report · off (défaut : enforce en production, report sinon)
# BOUFFE_CSP=enforce
# E-mail à l'administrateur sur erreur grave, un par heure au plus (défaut : oui en production)
# BOUFFE_ERROR_EMAIL=true
# Tâches planifiées : jeton de l'adresse /taches/{jeton} (vide = généré, visible dans Paramètres → Mise en ligne)
BOUFFE_TASKS_TOKEN=
# /sante répond « en panne » après N minutes sans passage des tâches
BOUFFE_TASKS_MAX_DELAY=90
# E-mail hebdomadaire à l'administrateur avec le lien de la dernière sauvegarde (jour : 0 = dimanche … 6)
BOUFFE_BACKUP_WEEKLY_EMAIL=false
BOUFFE_BACKUP_WEEKLY_EMAIL_DAY=1
# Où sont les données (page « Vos données »), par exemple : "chez OVHcloud, en France"
# BOUFFE_HOSTING="chez OVHcloud, en France"
